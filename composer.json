{
  "name": "lostfocus/oauth2-trakt",
  "description": "trakt.tv OAuth 2.0 Client Provider for The PHP League OAuth2-Client",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Dominik Schwind",
      "email": "dschwind@lostfocus.de",
      "homepage": "https://dominikschwind.com"
    },
    {
      "name": "Bogstag",
      "email": "krister@bogstag.se",
      "homepage": "https://github.com/bogstag"
    }
  ],
  "keywords": [
    "oauth",
    "oauth2",
    "client",
    "authorization",
    "authentication",
    "trakt"
  ],
  "minimum-stability": "dev",
  "require": {
    "php": ">=8.2.0",
    "league/oauth2-client": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Lostfocus\\OAuth2\\Client\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lostfocus\\OAuth2\\Client\\Test\\": "tests/src/"
    }
  }
}
